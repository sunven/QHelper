    "marked": "^18.0.13",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-json-view": "^1.21.3",
    "react-resizable-panels": "^4.12.4",
    "react-router": "^8.3.1",
