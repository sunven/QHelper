{
  "name": "qhelper",
  "version": "1.2.0",
  "description": "QHelper前端助手 - Chrome/Chromium 扩展",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "type-check": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:e2e:debug": "pnpm build && playwright test --debug"
  },
  "keywords": [
    "chrome-extension",
    "developer-tools"
  ],
  "author": "sunven",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "^5.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  }
}
